{
  "name": "kacean-admin",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev:shell": "pnpm --filter shell dev",
    "build:shell": "pnpm --filter shell build",
    "dev:module": "node scripts/run-module.mjs dev",
    "build:module": "node scripts/run-module.mjs build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check": "pnpm check:workspace && pnpm lint && pnpm typecheck",
    "verify": "pnpm check && pnpm build",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx,.vue --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "kacean",
  "license": "ISC",
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vue-eslint-parser": "^10.4.2"
  }
}
