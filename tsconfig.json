{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@kacean/types": ["./packages/types/src"],
      "@kacean/core": ["./packages/core/src"],
      "@kacean/common": ["./packages/common/src"],
      "@kacean/module": ["./packages/module/src/index.ts"],
      "@kacean/module/self": ["./packages/module/src/self.d.ts"],
      "@kacean/module/vite": ["./packages/module/src/vite.ts"],
      "@kacean/ui": ["./packages/ui/src"]
    }
  },
  "include": ["packages/**/*"],
  "references": [{ "path": "./packages/shell" }]
}
