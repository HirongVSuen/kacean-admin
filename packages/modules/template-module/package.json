{
  "name": "template-module",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/emit-remote-meta.mjs",
    "build:static": "vite build --mode static && node scripts/emit-remote-meta.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kacean/common": "workspace:*",
    "@kacean/shared": "workspace:*",
    "@kacean/types": "workspace:*",
    "tdesign-vue-next": "^1.20.11",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "unocss": "^66.13.0",
    "vite": "^5.4.11",
    "vue-tsc": "^3.3.14"
  }
}
